import React, { useState, useEffect } from "react";
import { doc, onSnapshot, updateDoc } from "firebase/firestore";
import { db } from "../../../firebase/firebaseConfig";
import Button from "../../../components/ui/Button";
import { 
    FiUser, FiEdit2, FiTarget, FiCamera, FiClipboard, FiActivity, 
    FiDollarSign, FiUsers, FiX, FiInfo, FiChevronRight, FiAlertCircle,
    FiBriefcase, FiCalendar, FiTrendingUp, FiFileText 
} from "react-icons/fi";

// Tabs Imports
import HistoriaClinicaContainer from "./HistoriaClinicaContainer";
import EvolucionesTab from "./EvolucionesTab";
import CrmTab from "./CrmTab";
import PresupuestosTab from "./PresupuestosTab";
import FacturacionTab from "./FacturacionTab";
import ConsentimientosTab from "./ConsentimientosTab";
import PatientRxTab from "./PatientRxTab";
import Odontograma from "../../odontograma/Odontograma";
import Periodontograma from "../../odontograma/Periodontograma";
import AseguramientoTab from "./AseguramientoTab";
import MarketingTab from "./MarketingTab";

// Helper Component: Info Field (Slender Pro Style)
const InfoField = ({ label, value, required, isFullWidth }) => (
    <div className={`flex flex-col gap-1.5 py-3 border-b border-slate-100 last:border-0 hover:bg-slate-50/20 transition-colors px-2 ${isFullWidth ? 'col-span-full' : ''}`}>
        <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest flex items-center gap-1">
            {label} {required && <span className="text-rose-500">*</span>}
        </label>
        <div className="text-[13px] font-black text-slate-800 uppercase tracking-tight">
            {value || "---"}
        </div>
    </div>
);

// Helper Component: Patient Info Tab (Matches OralDrive Layout)
const PatientInfoTab = ({ patient, section }) => {
    if (section === "datos") {
        return (
            <div className="flex flex-col lg:flex-row gap-10 p-4 md:p-8 animate-fadeIn">
                {/* 1. LEFT COLUMN: FORM FIELDS */}
                <div className="flex-1 space-y-10">
                    
                    {/* Identification Data Section */}
                    <div className="bg-white rounded-[32px] p-8 border border-slate-100 shadow-sm">
                        <div className="flex items-center gap-4 mb-8">
                            <div className="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 text-xs font-black">1</div>
                            <h4 className="text-[13px] font-black text-slate-700 uppercase tracking-widest">Datos de identificación</h4>
                        </div>
                        
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-2">
                            <InfoField label="Tipo de documento" value={patient.tipoDocumento} required />
                            <InfoField label="Nro. de documento" value={patient.nroDocumento} required />
                            <InfoField label="Número de Historia" value={patient.nroHistoria} />
                            <InfoField label="Fecha de ingreso" value={patient.fechaIngreso || "---"} />
                            <InfoField label="Nombres" value={patient.nombres} required isFullWidth />
                            <InfoField label="Apellidos" value={patient.apellidos} required isFullWidth />
                            <InfoField label="Nombre completo" value={patient.nombreCompleto} isFullWidth />
                            <InfoField label="Sexo" value={patient.sexo} required />
                            <InfoField label="Estado civil" value={patient.estadoCivil} required />
                            <InfoField label="País de nacimiento" value={patient.paisNacimiento} required />
                            <InfoField label="Ciudad de nacimiento" value={patient.ciudadNacimiento} />
                            <InfoField label="Fecha de Nacimiento" value={patient.fechaNacimiento} required />
                            <InfoField label="Edad" value={patient.edad} />
                        </div>
                    </div>

                    {/* Contact Data Section */}
                    <div className="bg-white rounded-[32px] p-8 border border-slate-100 shadow-sm">
                        <div className="flex items-center gap-4 mb-8">
                            <div className="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 text-xs font-black">2</div>
                            <h4 className="text-[13px] font-black text-slate-700 uppercase tracking-widest">Datos de contacto</h4>
                        </div>
                        
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-2">
                            <InfoField label="País de domicilio" value={patient.paisDomicilio} required />
                            <InfoField label="Ciudad de domicilio" value={patient.ciudadDomicilio} required />
                            <InfoField label="Barrio de domicilio" value={patient.barrio} required />
                            <InfoField label="Lugar de residencia" value={patient.lugarResidencia} required isFullWidth />
                            <InfoField label="Estrato" value={patient.estrato} />
                            <InfoField label="Zona residencial" value={patient.zonaResidencial} />
                            <InfoField label="Celular" value={patient.celular} required />
                            <InfoField label="Correo electrónico" value={patient.email} required isFullWidth />
                        </div>
                    </div>
                </div>

                {/* 2. RIGHT COLUMN: PHOTO & STATUS */}
                <div className="w-full lg:w-80 shrink-0 space-y-6">
                    <div className="bg-white rounded-[32px] p-8 border border-slate-100 shadow-sm flex flex-col items-center">
                        <div className="w-48 h-48 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200 flex flex-col items-center justify-center overflow-hidden mb-6 group relative">
                            {patient.fotoUrl ? (
                                <img src={patient.fotoUrl} className="w-full h-full object-cover" alt="Preview" />
                            ) : (
                                <div className="text-center p-4">
                                    <FiCamera size={40} className="text-slate-300 mx-auto mb-3" />
                                    <p className="text-[9px] text-slate-400 font-bold uppercase tracking-widest leading-relaxed">No hay foto<br/>disponible</p>
                                </div>
                            )}
                        </div>
                        
                        <button className="w-full py-3 bg-[#8CC63F] text-white text-[11px] font-black uppercase tracking-widest rounded-full shadow-lg shadow-[#8CC63F]/10 hover:bg-[#7bb335] transition-all flex items-center justify-center gap-2 mb-8">
                            <FiCamera size={14} /> Tomar foto
                        </button>

                        <div className="w-full space-y-3">
                            <div className="w-full py-3 bg-blue-600 text-white text-[9px] font-black uppercase tracking-widest rounded-lg flex items-center justify-center gap-2">
                                <FiActivity size={12} /> Valoración: el paciente está en valoración
                            </div>
                            <div className="w-full py-3 bg-emerald-500 text-white text-[9px] font-black uppercase tracking-widest rounded-lg flex items-center justify-center gap-2">
                                <FiDollarSign size={12} /> Sin deuda: el paciente no tiene pagos pendientes
                            </div>
                        </div>
                    </div>

                    {/* Extra Info (Alerts) */}
                    {patient.alertas && (
                         <div className="bg-rose-50 border border-rose-100 rounded-[32px] p-6 shadow-sm">
                            <h5 className="text-[10px] font-black text-rose-600 uppercase tracking-widest mb-2 flex items-center gap-2">
                                <FiAlertCircle /> Alertas Médicas
                            </h5>
                            <p className="text-[12px] font-bold text-slate-700 leading-relaxed uppercase">{patient.alertas}</p>
                        </div>
                    )}
                </div>
            </div>
        );
    }
    return null;
};

// Helper Component: Sidebar Button (Studio Sidebar Style)
const SidebarButton = ({ label, active, onClick, icon: Icon, badge }) => (
    <button
        onClick={onClick}
        className={`w-full group px-4 py-3 rounded-xl transition-all flex items-center justify-between border-l-4 ${active
            ? "bg-blue-50 border-blue-600 text-blue-700 shadow-sm"
            : "border-transparent text-slate-500 hover:bg-slate-50 hover:text-slate-800"
            }`}
    >
        <div className="flex items-center gap-3">
            <span className={`transition-transform duration-300 ${active ? "scale-110" : "group-hover:scale-110"}`}>
                <Icon size={16} className={active ? "text-blue-600" : "text-slate-400"} />
            </span>
            <span className={`text-[11px] font-black uppercase tracking-wider ${active ? 'opacity-100' : 'opacity-80'}`}>{label}</span>
        </div>
        {badge && (
            <span className="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[8px] font-black rounded-full uppercase">
                {badge}
            </span>
        )}
    </button>
);

const SidebarSectionTitle = ({ children }) => (
    <div className="text-[10px] font-black text-slate-700 uppercase tracking-[0.2em] mb-3 mt-8 px-4 border-b border-slate-100 pb-2">
        {children}
    </div>
);

export default function PatientDetails({ patientId, onClose, onEdit, onNavigate, onDelete }) {
    const [patient, setPatient] = useState(null);
    const [activeTab, setActiveTab] = useState("datos");

    useEffect(() => {
        if (!patientId) return;
        const unsub = onSnapshot(doc(db, "pacientes", patientId), (snap) => {
            if (snap.exists()) setPatient({ id: snap.id, ...snap.data() });
        });
        return () => unsub();
    }, [patientId]);

    // Handle Auto-Save for History Tab
    const handleAutoSave = async (key, value) => {
        if (!patientId) return;
        try {
            const ref = doc(db, "pacientes", patientId);
            await updateDoc(ref, { [key]: value });
        } catch (error) {
            console.error("Error updating patient:", error);
        }
    };

    if (!patient) return null;

    // Tabs that require full height usage without internal scrolling wrapper
    const isFullHeightTab = ['odonto', 'perio', 'presu', 'hc'].includes(activeTab);

    return (
        <div className="fixed inset-0 z-[9999] flex items-center justify-center p-2 md:p-6 lg:p-10 animate-fadeIn" role="dialog" aria-modal="true">
            {/* Backdrop con Glassmorphism */}
            <div className="absolute inset-0 bg-slate-900/40 backdrop-blur-md" onClick={onClose} />

            <div
                className="relative bg-white w-full max-w-[1400px] h-full rounded-[40px] shadow-[0_30px_100px_rgba(0,0,0,0.15)] overflow-hidden flex flex-col animate-scaleIn border border-white/20"
                onClick={(e) => e.stopPropagation()}
            >
                {/* 1. THE INSTITUTIONAL HUD (Header) */}
                <div className="bg-white px-4 md:px-10 py-6 md:py-8 border-b border-slate-100 flex flex-col md:flex-row justify-between items-center gap-6 shrink-0 z-20 shadow-sm relative">

                    {/* Alerta de Perfil Incompleto - Integrada en el HUD */}
                    {patient.registroCompleto === false && (
                        <div className="absolute top-0 left-0 right-0 bg-amber-500/10 border-b border-amber-500/10 px-10 py-1 flex items-center justify-center gap-3">
                            <FiAlertCircle className="text-amber-600" size={12} />
                            <span className="text-[9px] font-black text-amber-700 uppercase tracking-widest">Perfil Incompleto - Pendiente Formalización Clínica</span>
                        </div>
                    )}

                    <div className="flex items-center gap-4 md:gap-6 pt-4">
                        <div className="relative group">
                            {patient.fotoUrl ? (
                                <img src={patient.fotoUrl} alt="Foto" className="w-16 h-16 rounded-[24px] object-cover ring-4 ring-slate-50 shadow-xl" />
                            ) : (
                                <div className="w-16 h-16 rounded-[24px] bg-blue-600 flex items-center justify-center text-white font-black text-2xl ring-4 ring-slate-50 shadow-xl shadow-blue-100">
                                    {(patient.nombreCompleto || "P")[0]}
                                </div>
                            )}
                            <div className="absolute -bottom-1 -right-1 w-6 h-6 bg-white rounded-full flex items-center justify-center shadow-md border border-slate-100">
                                <div className={`w-3 h-3 rounded-full ${patient.activo !== false ? 'bg-emerald-500' : 'bg-slate-300'}`} />
                            </div>
                        </div>
                        <div>
                            <div className="flex items-center gap-3 mb-1">
                                <h3 className="text-lg md:text-2xl font-black text-slate-800 uppercase tracking-tight leading-none">{patient.nombreCompleto}</h3>
                                {patient.estado && (
                                    <span className="px-3 py-1 bg-blue-50 text-blue-600 text-[9px] font-black rounded-full uppercase tracking-widest border border-blue-100/50">
                                        {patient.estado}
                                    </span>
                                )}
                            </div>
                            <div className="flex items-center gap-4 text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                                <span className="flex items-center gap-1.5"><FiInfo className="text-blue-600" /> {patient.tipoDocumento} {patient.nroDocumento}</span>
                                <span className="w-1.5 h-1.5 bg-slate-200 rounded-full" />
                                <span>Expediente: <span className="text-slate-800">#{patient.nroHistoria || "S/N"}</span></span>
                            </div>
                        </div>
                    </div>

                    <div className="flex items-center gap-3 pt-4">
                        <button
                            onClick={() => onEdit(patient)}
                            className="flex items-center gap-3 px-8 py-4 bg-white border border-slate-100 rounded-[20px] text-[11px] font-black text-slate-600 uppercase tracking-[0.1em] hover:bg-slate-50 hover:text-blue-600 hover:shadow-lg transition-all active:scale-95"
                        >
                            <FiEdit2 size={14} />
                            Editar Registro
                        </button>

                        <button
                            onClick={onClose}
                            className="w-14 h-14 bg-slate-900 text-white rounded-[20px] flex items-center justify-center hover:bg-rose-600 transition-all active:scale-90 shadow-xl shadow-slate-200"
                        >
                            <FiX size={20} />
                        </button>
                    </div>
                </div>

                {/* 2. STUDIO WORKSPACE (Sidebar + Content) */}
                <div className="flex-1 flex flex-col xl:flex-row overflow-hidden">

                    {/* STUDIO SIDEBAR - Elite Triple Group */}
                    <aside className="w-full xl:w-72 bg-white border-b xl:border-b-0 xl:border-r border-slate-100 overflow-x-auto xl:overflow-y-auto p-4 flex flex-row xl:flex-col shrink-0 custom-scrollbar-hidden xl:custom-scrollbar scrollbar-hide">
                        
                        <div className="flex flex-col items-center p-6 mb-4 bg-slate-50/50 rounded-3xl border border-dashed border-slate-200">
                            <div className="relative mb-3">
                                {patient.fotoUrl ? (
                                    <img src={patient.fotoUrl} alt="Foto" className="w-20 h-20 rounded-full object-cover ring-4 ring-white shadow-md" />
                                ) : (
                                    <div className="w-20 h-20 rounded-full bg-blue-600 flex items-center justify-center text-white font-black text-2xl shadow-md">
                                        {(patient.nombreCompleto || "P")[0]}
                                    </div>
                                )}
                                <div className="absolute bottom-1 right-1 w-5 h-5 bg-emerald-500 rounded-full border-2 border-white shadow-sm" />
                            </div>
                            <h4 className="text-[12px] font-black text-slate-800 uppercase tracking-tight text-center">{patient.nombreCompleto}</h4>
                            <p className="text-[9px] font-bold text-slate-400 uppercase tracking-wider mt-1">{patient.nroDocumento}</p>
                        </div>

                        <SidebarSectionTitle>Información General</SidebarSectionTitle>
                        <div className="flex xl:flex-col gap-1 min-w-max xl:min-w-0">
                            <SidebarButton icon={FiUser} label="Datos personales" active={activeTab === "datos"} onClick={() => setActiveTab("datos")} />
                            <SidebarButton icon={FiTrendingUp} label="Marketing" active={activeTab === "mark"} onClick={() => setActiveTab("mark")} />
                            <SidebarButton icon={FiShield} label="EPS" active={activeTab === "eps"} onClick={() => setActiveTab("eps")} />
                            <SidebarButton icon={FiUsers} label="Beneficiarios convenio" active={activeTab === "conv"} onClick={() => setActiveTab("conv")} />
                            <SidebarButton icon={FiCamera} label="Rx / Imágenes / Doc" active={activeTab === "rx"} onClick={() => setActiveTab("rx")} />
                            <SidebarButton icon={FiBriefcase} label="Profesionales" active={activeTab === "pro"} onClick={() => setActiveTab("pro")} />
                            <SidebarButton icon={FiCalendar} label="Citas" active={activeTab === "citas"} onClick={() => setActiveTab("citas")} />
                            <SidebarButton icon={FiTarget} label="CRM" active={activeTab === "crm"} onClick={() => setActiveTab("crm")} />
                        </div>

                        <SidebarSectionTitle>Historia Clínica</SidebarSectionTitle>
                        <div className="flex xl:flex-col gap-1 min-w-max xl:min-w-0">
                            <SidebarButton icon={FiClipboard} label="Doc. Clínicos" active={activeTab === "hc"} onClick={() => setActiveTab("hc")} />
                            <SidebarButton icon={FiActivity} label="Odontogramas" active={activeTab === "odonto"} onClick={() => setActiveTab("odonto")} />
                            <SidebarButton icon={FiActivity} label="Periodontogramas" active={activeTab === "perio"} onClick={() => setActiveTab("perio")} />
                            <SidebarButton icon={FiFileText} label="Presupuestos & planes" active={activeTab === "presu"} onClick={() => setActiveTab("presu")} />
                            <SidebarButton icon={FiActivity} label="Evoluciones & Remis" active={activeTab === "evo"} onClick={() => setActiveTab("evo")} />
                        </div>

                        <SidebarSectionTitle>Facturación</SidebarSectionTitle>
                        <div className="flex xl:flex-col gap-1 min-w-max xl:min-w-0">
                            <SidebarButton icon={FiDollarSign} label="Saldo a favor" active={activeTab === "saldo"} onClick={() => setActiveTab("saldo")} badge="$" />
                            <SidebarButton icon={FiDollarSign} label="Realizar pago" active={activeTab === "pago"} onClick={() => setActiveTab("pago")} />
                            <SidebarButton icon={FiDollarSign} label="Histórico pagos" active={activeTab === "hist_pago"} onClick={() => setActiveTab("hist_pago")} />
                            <SidebarButton icon={FiFileText} label="Histórico facturas" active={activeTab === "hist_fact"} onClick={() => setActiveTab("hist_fact")} />
                        </div>

                        <div className="mt-8 p-4 bg-blue-600/5 rounded-2xl border border-blue-600/10 mb-4 hidden xl:block">
                            <p className="text-[8px] font-black text-blue-800 uppercase tracking-widest text-center">Elite Module v2.0</p>
                        </div>
                    </aside>

                    {/* STUDIO CONTENT WORKSPACE */}
                    <main className="flex-1 flex flex-col min-h-0 bg-white relative overflow-visible">
                        {/* Elite Section Header (matches screenshot) */}
                        <div className="px-10 py-4 bg-slate-50/80 backdrop-blur-sm border-b border-slate-200 flex flex-col md:flex-row justify-between items-center sticky top-0 z-10">
                            <div className="flex items-center gap-3">
                                <h3 className="text-[14px] font-black text-slate-800 uppercase tracking-tight">
                                    Edición Información Paciente
                                </h3>
                                <span className="text-slate-300">/</span>
                                <div className="flex items-center gap-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                                    <FiUser size={12} className="text-blue-600" />
                                    <span>Pacientes</span>
                                    <span>/</span>
                                    <span className="text-blue-600">Edición Información Paciente</span>
                                </div>
                            </div>
                            <button
                                onClick={() => {}} // TODO: Impl global save
                                className="px-8 py-2 bg-[#8CC63F] text-white text-[11px] font-black uppercase tracking-widest rounded-full shadow-lg shadow-[#8CC63F]/20 hover:bg-[#7bb335] active:scale-95 transition-all"
                            >
                                Guardar
                            </button>
                        </div>

                        <div className={`flex-1 flex flex-col min-h-0 ${isFullHeightTab ? 'overflow-visible' : 'overflow-y-auto custom-scrollbar animate-fadeIn p-2'}`}>
                            {activeTab === "datos" && <PatientInfoTab patient={patient} section="datos" />}
                            {activeTab === "mark" && <MarketingTab patient={patient} />}
                            {activeTab === "eps" && <AseguramientoTab patient={patient} />}
                            {activeTab === "rx" && <PatientRxTab patient={patient} onUpdate={setPatient} />}

                            {activeTab === "evo" && <EvolucionesTab patient={patient} />}
                            {activeTab === "fact" && <FacturacionTab patient={patient} />}
                            {activeTab === "crm" && <CrmTab patient={patient} />}

                            {activeTab === "hc" && <HistoriaClinicaContainer patient={patient} />}
                            {activeTab === "odonto" && <Odontograma embeddedPatient={patient} />}
                            {activeTab === "perio" && <Periodontograma embeddedPatient={patient} />}
                            {activeTab === "presu" && <PresupuestosTab patient={patient} />}
                            
                            {/* Placeholders for new sections */}
                            {["conv", "pro", "citas", "saldo", "pago", "hist_pago", "hist_fact"].includes(activeTab) && (
                                <div className="flex flex-col items-center justify-center min-h-[400px] p-10 text-center opacity-40">
                                    <FiActivity size={48} className="mb-4 text-slate-400" />
                                    <h5 className="text-[14px] font-black text-slate-600 uppercase tracking-widest">Módulo en Sincronización</h5>
                                    <p className="text-[11px] font-bold text-slate-400 uppercase tracking-widest mt-2">Esta sección está siendo integrada con el motor Elite</p>
                                </div>
                            )}
                        </div>
                    </main>
                </div>
            </div>
        </div>
    );
}
