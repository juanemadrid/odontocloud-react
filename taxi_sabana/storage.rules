rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Regla global por defecto: nadie lee ni escribe
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ✅ PERFILES DE PASAJEROS
    // Cada usuario solo puede escribir su propia foto: perfiles_pasajeros/{uid}.jpg
    // Cualquier usuario autenticado puede LEER (para ver avatares en chats, etc) 
    match /perfiles_pasajeros/{fileName} {
      allow read: if request.auth != null;
      // Validar que el nombre del archivo sea exactamente "{uid}.jpg"
      allow write: if request.auth != null && fileName == request.auth.uid + ".jpg";
    }

    // ✅ PERFILES DE CONDUCTORES
    match /perfiles_conductores/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName == request.auth.uid + ".jpg";
    }

    // ✅ ACTUALIZACIONES DE DOCUMENTOS (Conductor)
    match /updates/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }


    // ✅ PUBLICIDAD / ADS (Centro de Difusión)
    match /ads/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ✅ SOLICITUDES DE CONDUCTORES (Fotos y Docs)
    // Fix: Permitir leer para que el Admin vea las fotos y el Pasajero vea el avatar
    match /applications/{solicitudId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
